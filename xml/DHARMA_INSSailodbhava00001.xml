<lg met="anuṣṭubh" n="4">
<l>mā bhutaphalaśaṅkā va[ḥ]</l> <l>paradatte<lb break="no" n="29"/>[ti] pārthiva ||</l>
<l>svadānā phalam ānantya {||}</l> <l>parada[ttānupālane]||</l> 
</lg>

